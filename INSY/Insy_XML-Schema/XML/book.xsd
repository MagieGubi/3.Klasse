<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="book">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="title" type="xs:string"/>
                <xs:element name="author">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="given-name" type="xs:string"/>
                            <xs:element name="middle-name" type="xs:string" minOccurs="0"/>
                            <xs:element name="last-name" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="print" type="xs:string"/>
                <xs:element name="pages" type="xs:positiveInteger"/>
                <xs:element name="description" type="xs:string"/>
                <xs:element name="literature" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="symbol" type="xs:string" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>